{
  "name": "Olive Oil LIMS",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-servers.sh",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Frontend — LIMS",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "DATABASE_URL": "postgresql+asyncpg://lims:limsdev@localhost/olive_lims",
    "SYNC_DATABASE_URL": "postgresql+psycopg2://lims:limsdev@localhost/olive_lims",
    "SECRET_KEY": "dev-secret-key-codespaces-change-in-prod",
    "MEDIA_ROOT": "${containerWorkspaceFolder}/media",
    "CORS_ORIGINS": "http://localhost:5173,http://localhost:3000"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
